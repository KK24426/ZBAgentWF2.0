<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kk24426.zbagentwf.agent.persistence.mapper.ProbeMapper">
    <!-- table 仅来自 MySqlIT 的固定前缀+UUID 白名单；业务值全部绑定。 -->
    <insert id="insert">INSERT INTO ${table} (id, name) VALUES (#{id}, #{name})</insert>
    <select id="find" resultType="string">SELECT name FROM ${table} WHERE id = #{id}</select>
    <update id="update">UPDATE ${table} SET name = #{name} WHERE id = #{id}</update>
    <delete id="delete">DELETE FROM ${table} WHERE id = #{id}</delete>
</mapper>
